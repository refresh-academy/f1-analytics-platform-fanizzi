# Copy this file to .env only when creating a new local environment.
# Preserve an existing .env: initialized database volumes retain their passwords.
# Set private, nonempty values before starting the relevant services.
# Never commit the populated .env file.

# PostgreSQL batch administrator: f1_admin.
POSTGRES_PASSWORD=

# TimescaleDB telemetry administrator: f1_telemetry_admin.
TIMESCALEDB_PASSWORD=

# TimescaleDB read-only database role: grafana_telemetry_reader.
# Match the password assigned to that role during setup.
# This is separate from the Grafana web sign-in password.
GRAFANA_TELEMETRY_PASSWORD=
